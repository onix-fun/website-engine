# Local/demo configuration. CHANGE THESE VALUES outside local development.
POSTGRES_DB=engine
POSTGRES_USER=engine
POSTGRES_PASSWORD=engine
BOOTSTRAP_ADMIN_TOKEN=dev-admin-token-change-me-please
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PUBLIC_CORS_ORIGINS=

# --- Releases, environments and site serving ---

# 32-byte key for AES-GCM encryption of release-source credentials
# (base64). Generate a fresh one for production, e.g.:
#   openssl rand -base64 32
RELEASE_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Maximum release artifact size (256 MiB by default).
MAX_RELEASE_BYTES=268435456
# Cache directory for downloaded/extracted release artifacts.
RELEASE_CACHE_DIR=./data/releases

# Public base URLs of the environments; values seeded in the DB (site
# settings) always win over these ENV fallbacks.
DEV_PUBLIC_BASE_URL=http://localhost:8081
PROD_PUBLIC_BASE_URL=http://localhost:8082
# Bootstrap CORS origins per environment; DB values (environment
# settings in the admin UI) always win over these.
PUBLIC_CORS_ORIGINS_DEV=http://localhost:8081
PUBLIC_CORS_ORIGINS_PROD=http://localhost:8082

# --- HTTPS / ACME (optional) ---
# Turning TLS on starts a second listener (HTTPS_ADDR) which serves the
# site content routed by host + SNI, and an HTTP listener used for
# ACME challenges and HTTP->HTTPS redirects. Requires certificates to
# be reachable only by the hosts from the environment settings.
TLS_ENABLED=false
HTTPS_ADDR=:443
TLS_HTTP_ADDR=:80
# Let's Encrypt account email and a stable cache directory.
ACME_EMAIL=
# Use the Let's Encrypt staging CA while testing.
ACME_STAGING=false
TLS_CACHE_DIR=./data/tls
